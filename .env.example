# Copy this file to .env and fill in real values. Never commit the real .env.
#
# How to load these into your shell before running scripts/run_ingestion.py
# (or anything else that reads them via os.environ):
#   export $(grep -v '^#' .env | xargs)
# or use a tool like direnv / python-dotenv if you prefer.

# Postgres connection string used by store/recipe_store.py and
# store/recipe_annotation_store.py (via async_store/async_postgres_store.py).
RECIPE_ENGINE_DATABASE_URL=postgresql://recipe_engine:password@localhost:5432/recipe_engine

# AWS credentials/region used by aioboto3 for data_pipeline/ingester.py's raw
# HTML archive (S3 bucket "recipe-data"). Leave unset to use the default AWS
# credential chain (~/.aws/credentials, an instance role, etc).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
